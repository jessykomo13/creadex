# Copie ce fichier en ".env" et remplis les valeurs

# Provider utilise pour la generation IA 3D : "replicate" ou "meshy"
PROVIDER=replicate

# Cle API du provider choisi
API_KEY=

# --- Config specifique Replicate (PROVIDER=replicate) ---
# ID de version du modele image->3D (ex: modele "TripoSR" ou "Stable Fast 3D")
REPLICATE_IMAGE_TO_3D_VERSION=
# ID de version du modele texte->3D (ex: modele "Shap-E" ou equivalent)
REPLICATE_TEXT_TO_3D_VERSION=

# --- Config specifique Meshy (PROVIDER=meshy) ---
# Base URL de l'API Meshy (voir https://docs.meshy.ai)
MESHY_API_BASE=https://api.meshy.ai

# Port du serveur local
PORT=3000
